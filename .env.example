# --- Site (optional) ---
# Public canonical URL, used for SEO metadata, robots.txt, and the sitemap.
# e.g. https://datenightconcierge.app
NEXT_PUBLIC_SITE_URL=

# --- Supabase (required) ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Service role key — used ONLY on the server (API route) to insert requests.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin area (required to sign in at /admin) ---
# The single shared password for the concierge admin queue.
ADMIN_PASSWORD=
# Any long random string — used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=

# --- Notifications (optional, but this is how you get "texted back") ---
# You get pinged the moment a couple submits the intake form.

# Telegram: create a bot via @BotFather, then message it once and grab your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via Resend (https://resend.com). Leave blank to skip email notifications.
RESEND_API_KEY=
# Where the "new request" email is sent (your phone's email-to-SMS or inbox).
NOTIFY_EMAIL_TO=
# Verified sender on your Resend account.
NOTIFY_EMAIL_FROM=concierge@yourdomain.com

# --- Outbound SMS to couples (optional) ---
# Lets the "Text back" composer in /admin send the itinerary via Twilio.
# Leave blank and the composer falls back to copy-paste-and-send-yourself.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number texts are sent from, in E.164, e.g. +15551234567
TWILIO_FROM_NUMBER=
